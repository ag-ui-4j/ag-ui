<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.agui4j</groupId>
    <artifactId>agui4j-adk</artifactId>
    <version>0.2.0</version>
    <packaging>jar</packaging>
    <name>agui4j-adk</name>
    <description>
        AG-UI &#x2192; Google ADK (Java) integration. Bridges the official AG-UI protocol
        (io.github.agui4j, 0.2.0) event stream to a Google ADK Runner. Extracted from a
        KoralPlay internal module for upstream consideration; see UPSTREAM.md / NOTICE.md.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <google-adk.version>1.7.0</google-adk.version>
        <ag-ui-4j.version>0.2.0</ag-ui-4j.version>
        <jackson.version>2.18.2</jackson.version>
        <rxjava.version>3.1.12</rxjava.version>
        <slf4j.version>2.0.16</slf4j.version>
        <junit.version>6.0.1</junit.version>
        <assertj.version>3.27.6</assertj.version>
        <mockito.version>5.20.0</mockito.version>
    </properties>

    <dependencies>
        <!-- Official AG-UI protocol (core + server) -->
        <dependency>
            <groupId>io.github.ag-ui-4j</groupId>
            <artifactId>core</artifactId>
            <version>${ag-ui-4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.ag-ui-4j</groupId>
            <artifactId>server</artifactId>
            <version>${ag-ui-4j.version}</version>
        </dependency>
        <!-- Official Google ADK -->
        <dependency>
            <groupId>com.google.adk</groupId>
            <artifactId>google-adk</artifactId>
            <version>${google-adk.version}</version>
        </dependency>
        <!-- Reactive bridge plumbing -->
        <dependency>
            <groupId>io.reactivex.rxjava3</groupId>
            <artifactId>rxjava</artifactId>
            <version>${rxjava.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <excludedGroups>live</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
